#!/bin/bash
# ============================================
# SimpleStaff - NS8 Update Module Hook
# ============================================

exec 1>&2  # Redirect stdout to stderr for journald logging
echo "SimpleStaff: Update hook starting..."

# Migrate legacy state directory if present in ~/.config/state
if [ -d "$HOME/.config/state" ] && [ ! -d "$HOME/state" ]; then
    echo "SimpleStaff: Migrating legacy state directory to $HOME/state..."
    mv "$HOME/.config/state" "$HOME/state" 2>/dev/null || true
fi

if [ -f "$HOME/state/environment" ]; then
    echo "SimpleStaff: Loading environment variables from state/environment..."
    set -a
    . "$HOME/state/environment"
    set +a
elif [ -f environment ]; then
    echo "SimpleStaff: Loading environment variables..."
    set -a
    . ./environment
    set +a
fi

echo "SimpleStaff: Reloading systemd daemon..."
systemctl --user daemon-reload || true

echo "SimpleStaff: Restarting simplestaff.service..."
systemctl --user restart simplestaff.service || true

echo "SimpleStaff: Update hook completed successfully."
exit 0
