#!/bin/bash

#
# SimpleStaff - Start/Restart services after configuration
#

set -e

# Redirect output to journal (stderr)
exec 1>&2

echo "SimpleStaff: Reloading systemd daemon..."
systemctl --user daemon-reload

echo "SimpleStaff: Enabling and restarting simplestaff.service with new configuration..."
systemctl --user enable simplestaff.service 2>/dev/null || true
systemctl --user restart simplestaff.service

echo "SimpleStaff: Services restarted successfully."
