{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "description": "SimpleStaff module configuration output schema",
    "type": "object",
    "properties": {
        "domain_name": {
            "type": "string",
            "title": "Domain name"
        },
        "app_url": {
            "type": "string",
            "title": "Application URL"
        },
        "super_admin_email": {
            "type": "string",
            "title": "Super admin email"
        },
        "is_configured": {
            "type": "boolean",
            "title": "Whether initial configuration has been completed"
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt SSL certificate"
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirect"
        },
        "smtp_enabled": {
            "type": "boolean",
            "title": "SMTP Enabled"
        },
        "smtp_host": {
            "type": "string",
            "title": "SMTP Host"
        },
        "smtp_port": {
            "type": "integer",
            "title": "SMTP Port"
        },
        "smtp_user": {
            "type": "string",
            "title": "SMTP User"
        },
        "smtp_from": {
            "type": "string",
            "title": "SMTP From Address"
        },
        "has_smtp_password": {
            "type": "boolean",
            "title": "Whether an SMTP password is stored"
        }
    }
}
