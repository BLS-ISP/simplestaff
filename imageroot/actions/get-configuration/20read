#!/usr/bin/env python3

#
# SimpleStaff - NS8 get-configuration action
# Returns current module configuration as JSON to stdout.
#

import os
import json
import sys
import traceback

def log_error(msg):
    print(f"ERROR: {msg}", file=sys.stderr)

try:
    import agent
except Exception as e:
    log_error(f"Failed to import NS8 agent: {e}")
    traceback.print_exc(file=sys.stderr)
    sys.exit(1)

try:
    domain_name = os.environ.get('DOMAIN_NAME', '').strip()
    super_admin_email = os.environ.get('SUPER_ADMIN_EMAIL', '').strip()
    lets_encrypt_str = os.environ.get('LETS_ENCRYPT', 'True')
    http2https_str = os.environ.get('HTTP2HTTPS', 'True')
    smtp_enabled_str = os.environ.get('SMTP_ENABLED', 'False')

    smtp_port_raw = os.environ.get('SMTP_PORT', '587')
    try:
        smtp_port = int(smtp_port_raw)
    except (ValueError, TypeError):
        smtp_port = 587

    config = {
        "domain_name": domain_name,
        "app_url": f"https://{domain_name}" if domain_name else "",
        "super_admin_email": super_admin_email,
        "is_configured": bool(domain_name and super_admin_email and os.environ.get('SUPER_ADMIN_PASSWORD')),
        "lets_encrypt": lets_encrypt_str.lower() in ('true', '1', 'yes'),
        "http2https": http2https_str.lower() in ('true', '1', 'yes'),
        "smtp_enabled": smtp_enabled_str.lower() in ('true', '1', 'yes'),
        "smtp_host": os.environ.get('SMTP_HOST', ''),
        "smtp_port": smtp_port,
        "smtp_user": os.environ.get('SMTP_USER', ''),
        "smtp_from": os.environ.get('SMTP_FROM', ''),
        "has_smtp_password": bool(os.environ.get('SMTP_PASSWORD')),
    }

    json.dump(config, fp=sys.stdout)
    sys.stdout.flush()

except Exception as e:
    log_error(f"Unexpected error during get-configuration: {e}")
    traceback.print_exc(file=sys.stderr)
    sys.exit(1)
