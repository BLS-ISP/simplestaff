#!/usr/bin/env python3

#
# SimpleStaff - NS8 clone-module step 50configure
#

import os
import agent
import agent.tasks

domain_name = os.environ.get("DOMAIN_NAME", "")
super_admin_email = os.environ.get("SUPER_ADMIN_EMAIL", "")

if domain_name and super_admin_email:
    try:
        smtp_port = int(os.environ.get("SMTP_PORT") or 587)
    except (ValueError, TypeError):
        smtp_port = 587

    configure_retval = agent.tasks.run(
        agent_id=os.environ["AGENT_ID"],
        action="configure-module",
        data={
            "domain_name": domain_name,
            "super_admin_email": super_admin_email,
            "super_admin_password": "",
            "lets_encrypt": os.environ.get("LETS_ENCRYPT", "True") == "True",
            "http2https": os.environ.get("HTTP2HTTPS", "True") == "True",
            "smtp_enabled": os.environ.get("SMTP_ENABLED", "False") == "True",
            "smtp_host": os.environ.get("SMTP_HOST", ""),
            "smtp_port": smtp_port,
            "smtp_user": os.environ.get("SMTP_USER", ""),
            "smtp_password": "",
            "smtp_from": os.environ.get("SMTP_FROM", ""),
        },
    )
    agent.assert_exp(configure_retval["exit_code"] == 0, "The configure-module subtask failed!")
