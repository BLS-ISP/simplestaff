#!/usr/bin/env python3

#
# SimpleStaff - NS8 restore-module step 06copyenv
#

import json
import sys
import agent

request = json.load(sys.stdin)
original_environment = request.get("environment", {})

for evar in [
    "DOMAIN_NAME",
    "SUPER_ADMIN_EMAIL",
    "SUPER_ADMIN_PASSWORD",
    "DATABASE_PASSWORD",
    "JWT_SECRET",
    "LETS_ENCRYPT",
    "HTTP2HTTPS",
    "SMTP_ENABLED",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "SMTP_FROM",
    "APP_BASE_URL",
]:
    if evar in original_environment:
        agent.set_env(evar, original_environment[evar])

agent.dump_env()
