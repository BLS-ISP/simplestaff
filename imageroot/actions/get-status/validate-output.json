{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-status output",
    "description": "SimpleStaff module status output schema",
    "type": "object",
    "properties": {
        "instance": {
            "type": "string"
        },
        "node": {
            "type": "string"
        },
        "node_ui_name": {
            "type": "string"
        },
        "services": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "status": { "type": "string" },
                    "active": { "type": "boolean" },
                    "failed": { "type": "boolean" }
                }
            }
        },
        "images": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "size": { "type": "string" },
                    "created": { "type": "string" }
                }
            }
        },
        "volumes": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "mount": { "type": "string" },
                    "created": { "type": "string" }
                }
            }
        }
    }
}
