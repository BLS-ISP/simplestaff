#!/usr/bin/env python3

#
# SimpleStaff - NS8 destroy-module action
# Stops containers/services, cleans up Traefik routes, and releases resources.
#

import agent
import agent.tasks
import os
import subprocess
import sys
import traceback

def log_error(msg):
    print(f"ERROR: {msg}", file=sys.stderr)

try:
    module_id = os.environ.get('MODULE_ID')
    print(f"Destroying module={module_id}...", file=sys.stderr)

    # 1. Stop systemd service and remove pod/containers
    subprocess.run(['systemctl', '--user', 'disable', '--now', 'simplestaff.service'], check=False)
    subprocess.run(['podman', 'pod', 'rm', '-f', 'simplestaff-pod'], check=False)
    subprocess.run(['podman', 'rm', '-f', 'simplestaff-db', 'simplestaff-backend', 'simplestaff-frontend'], check=False)

    # 2. Delete Traefik reverse proxy route
    if module_id:
        traefik_agent_id = agent.resolve_agent_id('traefik@node')
        if traefik_agent_id:
            print(f"Resolved Traefik agent ID: {traefik_agent_id}", file=sys.stderr)
            response = agent.tasks.run(
                agent_id=traefik_agent_id,
                action='delete-route',
                data={
                    'instance': module_id,
                },
            )
            print(f"Traefik delete-route completed with exit_code={response.get('exit_code')}", file=sys.stderr)

except Exception as e:
    log_error(f"Unexpected error during destroy-module: {e}")
    traceback.print_exc(file=sys.stderr)
    # Do not fail the destroy process so module removal can complete
